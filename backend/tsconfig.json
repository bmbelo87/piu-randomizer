{
  "compilerOptions": {
    "target": "ES2020",
    "types": ["node"],
    "module": "commonjs",
    "moduleResolution": "bundler",

    "strict": true,

    "esModuleInterop": true,

    "skipLibCheck": true,

    "forceConsistentCasingInFileNames": true,

    "outDir": "./dist",
    "rootDir": "./src"
  },

    "include": [
      "src"
    ]

}